{
  "name": "@dbi/connector",
  "version": "0.1.1",
  "private": true,
  "author": "DBI Intelligence",
  "description": "DBI Footfall Connector - on-site Windows agent that pairs a shop's LAN with the cloud API and syncs cameras that are not directly reachable by the cloud AI worker.",
  "main": "src/main.js",
  "scripts": {
    "prestart": "node scripts/write-runtime-config.js",
    "start": "electron .",
    "predist": "node scripts/write-runtime-config.js && node scripts/prepare-python.js",
    "dist": "electron-builder --win --publish never",
    "prepublish": "node scripts/write-runtime-config.js"
  },
  "dependencies": {
    "electron-log": "^5.2.3",
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "app-builder-bin": "^4.2.0",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.dbi.footfallconnector",
    "productName": "DBI Footfall Connector",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "build-resources/python",
        "to": "python"
      },
      {
        "from": "build-resources/ai-worker",
        "to": "ai-worker"
      },
      {
        "from": "build-resources/go2rtc",
        "to": "go2rtc"
      }
    ],
    "win": {
      "target": "nsis",
      "artifactName": "DBI-Footfall-Connector-Setup.${ext}",
      "publish": {
        "provider": "generic",
        "url": "https://footfall.api.digitalbookofindia.com/downloads/connector"
      }
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
