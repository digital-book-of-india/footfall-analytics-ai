NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://localhost:27017/dbi_footfall
REDIS_URL=redis://localhost:6379
CORS_ORIGIN=https://footfall.digitalbookofindia.com,https://admin.footfall.digitalbookofindia.com,http://localhost:3000,http://localhost:3001

JWT_ACCESS_SECRET=replace_me_with_a_secure_random_jwt_secret_key_32_bytes_min
CAMERA_SECRET_ENCRYPTION_KEY=replace_me_with_managed_32_bytes_key_for_aes_256_gcm
AI_SERVICE_SHARED_SECRET=replace_me_with_internal_ai_service_shared_secret

CAMERA_HEARTBEAT_TIMEOUT_SEC=90

# Zone-watch evidence snapshots (apps/api/src/services/evidence) — where the AI worker's
# uploaded JPEG alerts are stored on disk, and how long a signed evidence link stays valid.
EVIDENCE_STORAGE_DIR=storage/evidence
EVIDENCE_URL_TTL_SECONDS=600

# Optional - Cloudflare Realtime TURN credentials for WebRTC live view behind strict
# NAT/firewalls. Leave unset to fall back to STUN-only (works for most shop networks).
CF_TURN_KEY_ID=
CF_TURN_API_TOKEN=