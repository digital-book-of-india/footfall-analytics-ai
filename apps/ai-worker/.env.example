CORE_API_URL=https://footfall.api.digitalbookofindia.com
AI_SERVICE_SHARED_SECRET=dbi_ai_service_shared_secret_2026
HEARTBEAT_INTERVAL_SEC=30
CAMERA_DISCOVERY_INTERVAL_SEC=60
DETECTION_INTERVAL_SEC=0.5
MODEL_VERSION=hog-crossing-v1.0

# All of the below are optional — sane defaults in config.py / the modules that read them.
# Run `python scripts/prepare_models.py` first to fetch the YOLOX/YuNet model files; without
# them person_detector.py falls back to HOG and face_check.py's suppression is skipped.
#
# Security zone (shutter/gate) watching — see zones/zone_loader.py:
# MIN_ZONE_PERSON_CONFIDENCE=0.5
# MIN_PERSON_HEIGHT=0.25
# MIN_ZONE_OVERLAP=0
# IGNORE_REGION_IOU=0.4
#
# Zone-watch alert timing — see heuristics/classifier.py:
# PERSON_STILL_SECONDS=5
# SHUTTER_INTERACTION_SECONDS=10
# STILL_MAX_MOVE=0.07
# EVENT_COOLDOWN_SECONDS=300
# ABSENCE_GRACE_SECONDS=5
# MIN_DETECTIONS_TO_ALERT=3
#
# Detector model paths/thresholds — see detection/person_detector.py, detection/face_check.py:
# YOLOX_MODEL_PATH=
# YOLOX_SCORE_THRESHOLD=0.35
# YUNET_MODEL_PATH=
# FACE_SCORE_THRESHOLD=0.6
#
# Background (arrived-vs-always-there) model — see detection/background.py:
# BG_DIFF_THRESHOLD=25
# BG_MIN_FOREGROUND=0.2
